# Copy to .env.local to override. Release builds talk to https://recipe.civar.io. In development the
# app talks to port 8055 on the machine running Metro (iOS simulator, or a phone on the same Wi-Fi).
# To test a dev build against the live server: EXPO_PUBLIC_API_URL=https://recipe.civar.io
# EXPO_PUBLIC_API_URL=http://192.168.1.7:8055

# Only if the backend has API_KEY set
# EXPO_PUBLIC_API_KEY=
